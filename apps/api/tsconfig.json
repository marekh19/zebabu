{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@zebabu/tooling/tsconfig/library.json",
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["bun"],
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"]
    }
  },
  "include": ["src"]
}
