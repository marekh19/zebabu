{
  "name": "@zebabu/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite dev --port 3000 --host",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck:dev": "svelte-check --tsconfig ./tsconfig.json",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix .",
    "knip": "knip",
    "test": "vitest --run",
    "clean": "rm -rf .svelte-kit build node_modules"
  },
  "dependencies": {
    "@dnd-kit-svelte/svelte": "^0.2.0",
    "@dnd-kit/dom": "~0.5.3",
    "@dnd-kit/helpers": "~0.5.3",
    "@zebabu/api-contract": "workspace:*",
    "@orpc/client": "1.16.1",
    "@orpc/contract": "1.16.1",
    "@orpc/openapi-client": "1.16.1",
    "@zebabu/ui": "workspace:*",
    "better-auth": "1.7.18",
    "mode-watcher": "^1.1.0",
    "narrowland": "^1.9.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^3.2.0",
    "@lucide/svelte": "^1.69.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/bun": "1.4.4",
    "@types/node": "^26.6.6",
    "@zebabu/tooling": "workspace:*",
    "eslint": "^10.14.0",
    "svelte": "^5.57.3",
    "svelte-adapter-bun": "1.0.2",
    "svelte-check": "^4.7.8",
    "svelte-sonner": "^1.2.3",
    "sveltekit-superforms": "^2.30.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-devtools-json": "^1.1.2",
    "vitest": "^4.1.11",
    "zod": "^4.3.6"
  }
}
