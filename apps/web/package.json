{
  "name": "@zebabu/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite dev --port 3000 --host",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix .",
    "knip": "knip",
    "test": "vitest --run",
    "clean": "rm -rf .svelte-kit build node_modules",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "redis:studio": "redis-commander --redis-host localhost --redis-port 6379"
  },
  "dependencies": {
    "@dnd-kit-svelte/svelte": "^0.1.6",
    "@dnd-kit/helpers": "~0.2.4",
    "@zebabu/emails": "workspace:*",
    "better-auth": "^1.6.27",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "nanoid": "^6.0.1",
    "narrowland": "^1.9.0",
    "drizzle-orm": "^0.45.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.23.2",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.31.0",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "bits-ui": "^2.18.1",
    "drizzle-kit": "^0.31.9",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "formsnap": "^2.0.1",
    "globals": "^17.11.0",
    "redis-commander": "^0.9.0",
    "svelte": "^5.56.9",
    "svelte-adapter-bun": "latest",
    "svelte-check": "^4.7.5",
    "svelte-sonner": "^1.0.8",
    "sveltekit-superforms": "^2.30.2",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-devtools-json": "^1.1.0",
    "vitest": "^4.1.10",
    "zod": "^4.3.6"
  }
}
