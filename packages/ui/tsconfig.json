{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@zebabu/tooling/tsconfig/library.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.svelte", "src/**/*.ts"]
}
