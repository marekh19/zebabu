{
  "name": "@zebabu/api-contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir dist --format esm --target bun && tsc --declaration --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint:check": "eslint ."
  },
  "dependencies": {
    "@orpc/contract": "1.15.1",
    "zod": "~4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/bun": "1.4.0",
    "@zebabu/tooling": "workspace:*",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0"
  }
}
